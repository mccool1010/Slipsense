# Copy this file to .env and fill in your own values.
#
# The Cesium Ion token used to be a string literal in src/components/CesiumView.jsx,
# which shipped a live credential in every build and committed it to version control.
# Revoke that token at https://ion.cesium.com/tokens and issue a new one here.
#
# Vite only exposes variables prefixed VITE_ to the client, so the REACT_APP_ prefix
# this file previously suggested would silently have had no effect.
VITE_CESIUM_ION_TOKEN=

# Backend tile/API server.
VITE_TILE_SERVER=http://localhost:8000
