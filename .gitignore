# Generated geospatial artifacts (rebuildable from the scripts in ml_models/).
# These total ~7 GB and must not enter git history. Rebuild with:
#   python ml_models/build_terrain_stack.py
#   python ml_models/build_soil_layer.py
#   python ml_models/build_landcover_layer.py
#   python ml_models/generate_susceptibility_v2.py
#   python ml_models/generate_runout_v2.py
